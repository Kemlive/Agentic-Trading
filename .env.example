# Network / RPC (informational; reads go through wallet-signer / rubic MCP)
TRADING_NETWORK=solana
RPC_URL=

# --- Live Phase 1: Solana wallet (PUBLIC KEY ONLY, never a secret) ---
# Created by the boss in Phantom; paste the public address here and in data/live/config.json.
SOLANA_WALLET_PUBLIC_KEY=
SOLANA_CLUSTER=mainnet-beta

# EVM wallet address (informational, from connect_wallet)
WALLET_ADDRESS=

# Paths used by the agents (relative to project root)
PORTFOLIO_FILE=data/portfolio.json
RESEARCH_DIR=research
TRADE_LOG_FILE=logs/trades.jsonl

# Safety: keep true until you are ready for live swaps
DRY_RUN=true
# Execution model: manual (Phase 1). Automated signing is NOT wired and must not be assumed.
EXECUTION_MODE=manual

